@model PropertyManagementDemo.ViewModels.Manager.UnitFormViewModel

<form asp-area="Manager" asp-controller="Units" asp-action="Save" method="post" data-modal-form novalidate>
    <div class="modal-header">
        <h2 class="modal-title h5">@(Model.Id is null ? "Add unit" : "Edit unit")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PropertyId" />

        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="UnitTypeId" class="form-label"></label>
            <select asp-for="UnitTypeId" asp-items="Model.UnitTypes" class="form-select">
                <option value="">Select a type</option>
            </select>
            <span asp-validation-for="UnitTypeId" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <input asp-for="MonthlyRent" class="form-control" />
                <span asp-validation-for="MonthlyRent" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
