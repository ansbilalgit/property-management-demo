@using Infrastructure.Dtos
@model IReadOnlyList<UnitDto>

@if (Model.Count == 0)
{
    <p class="text-muted">No units yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Unit</th>
                <th>Type</th>
                <th class="text-end">Bedrooms</th>
                <th class="text-end">Monthly rent</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.UnitNumber</td>
                <td>
                    @u.UnitTypeName
                    @if (!u.UnitTypeIsActive)
                    {
                        <span class="badge text-bg-secondary">inactive</span>
                    }
                </td>
                <td class="text-end">@u.Bedrooms</td>
                <td class="text-end">@u.MonthlyRent.ToString("C")</td>
                <td class="text-end text-nowrap">
                    <a href="#" class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Edit", "Units", new { area = "Manager", id = u.Id })">Edit</a>
                    <a href="#" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("Delete", "Units", new { area = "Manager", id = u.Id })">Remove</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
