@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="row">
    <aside class="col-md-3 col-lg-2 mb-3">
        <div class="list-group">
            <a class="list-group-item list-group-item-action @(current == "Dashboard" ? "active" : "")"
               asp-area="Manager" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="list-group-item list-group-item-action @(current is "Properties" or "Units" ? "active" : "")"
               asp-area="Manager" asp-controller="Properties" asp-action="Index">Properties</a>
            @* Applications link is added when that feature is built. *@
        </div>
    </aside>
    <section class="col-md-9 col-lg-10">
        @RenderBody()
    </section>
</div>

<div class="modal fade" id="app-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="app-modal-content"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/modal-forms.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
