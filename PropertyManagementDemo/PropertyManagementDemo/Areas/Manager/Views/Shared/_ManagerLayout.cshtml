@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="row">
    <aside class="col-md-3 col-lg-2 mb-3">
        <div class="list-group">
            <a class="list-group-item list-group-item-action @(current == "Dashboard" ? "active" : "")"
               asp-area="Manager" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            @* Properties, Units and Applications links are added as those features are built. *@
        </div>
    </aside>
    <section class="col-md-9 col-lg-10">
        @RenderBody()
    </section>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
