@model PropertyManagementDemo.ViewModels.Applicant.ApplicationViewModel

<h2 class="h5 mb-3">Summary</h2>

<div class="d-flex align-items-center mb-2">
    <h3 class="h6 mb-0 me-2">Applicant information</h3>
    @if (Model.ApplicantInfoSaved)
    {
        <span class="badge text-bg-success">Saved</span>
    }
    else
    {
        <span class="badge text-bg-warning">Not saved</span>
    }
</div>
<dl class="row mb-4">
    <dt class="col-sm-3">Full name</dt>
    <dd class="col-sm-9">@Model.ApplicantInfo.FullName</dd>
    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.ApplicantInfo.Phone</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.ApplicantInfo.Email</dd>
    <dt class="col-sm-3">Current address</dt>
    <dd class="col-sm-9">@Model.ApplicantInfo.CurrentAddress</dd>
</dl>

<div class="d-flex align-items-center mb-2">
    <h3 class="h6 mb-0 me-2">Residence history</h3>
    @if (Model.ResidenceHistorySaved)
    {
        <span class="badge text-bg-success">Saved</span>
    }
    else
    {
        <span class="badge text-bg-warning">Not saved</span>
    }
</div>
@if (Model.Residences.Count == 0)
{
    <p class="text-muted mb-0">No residences.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Address</th>
                    <th>Landlord</th>
                    <th>Move-in</th>
                    <th>Move-out</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Residences)
            {
                <tr>
                    <td>@r.Address</td>
                    <td>@r.LandlordName (@r.LandlordPhone)</td>
                    <td>@r.MoveInDate.ToString("d")</td>
                    <td>@r.MoveOutDate.ToString("d")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
