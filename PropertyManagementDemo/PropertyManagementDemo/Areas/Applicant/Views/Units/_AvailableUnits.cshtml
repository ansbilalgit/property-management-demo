@using Services.Dtos
@model IReadOnlyList<UnitDto>

@if (Model.Count == 0)
{
    <p class="text-muted">There are no units available right now.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Property</th>
                <th>Unit</th>
                <th>Type</th>
                <th class="text-end">Bedrooms</th>
                <th class="text-end">Monthly rent</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.PropertyName</td>
                <td>@u.UnitNumber</td>
                <td>@u.UnitTypeName</td>
                <td class="text-end">@u.Bedrooms</td>
                <td class="text-end">@u.MonthlyRent.ToString("C")</td>
                <td class="text-end">
                    <form asp-area="Applicant" asp-controller="Applications" asp-action="Start" method="post">
                        <input type="hidden" name="unitId" value="@u.Id" />
                        <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
