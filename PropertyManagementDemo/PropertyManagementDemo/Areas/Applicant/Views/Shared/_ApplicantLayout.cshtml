@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mx-auto" style="max-width: 960px;">
    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-area="Applicant" asp-controller="Dashboard" asp-action="Index">My dashboard</a>
        </li>
        @* Browse Units and My Applications links are added as those features are built. *@
    </ul>

    @RenderBody()
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
